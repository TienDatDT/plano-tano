generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
}

model Supplier {
  id             String    @id @default(uuid())
  name           String
  representative String?
  address        String?
  email          String?
  phone          String?
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  stockIns       StockIn[]

  @@index([name])
}

model Unit {
  id              String           @id @default(uuid())
  name            String
  symbol          String?
  variants        ProductVariant[]
  fromConversions UnitConversion[] @relation("fromUnit")
  toConversions   UnitConversion[] @relation("toUnit")
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String?
  categoryId      String
  imageUrl        String?
  status          ProductStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        Category         @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  unitConversions UnitConversion[]

  @@index([name])
  @@index([categoryId])
}

model ProductVariant {
  id           String        @id @default(uuid())
  productId    String
  unitId       String
  sku          String        @unique
  salePrice    Decimal       @db.Decimal(10, 2)
  costPrice    Decimal?      @db.Decimal(10, 2)
  status       VariantStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  batches      Batch[]
  orderItems   OrderItem[]
  product      Product       @relation(fields: [productId], references: [id])
  unit         Unit          @relation(fields: [unitId], references: [id])
  stockInItems StockInItem[]

  @@index([productId])
  @@index([unitId])
}

model UnitConversion {
  id         String  @id @default(uuid())
  productId  String
  fromUnitId String
  toUnitId   String
  ratio      Decimal @db.Decimal(10, 2)
  fromUnit   Unit    @relation("fromUnit", fields: [fromUnitId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  toUnit     Unit    @relation("toUnit", fields: [toUnitId], references: [id])

  @@index([productId])
}

model StoreLayout {
  id        String   @id @default(uuid())
  name      String
  width     Int
  height    Int
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  shelves   Shelf[]
}

model ShelfTemplate {
  id          String          @id @default(uuid())
  name        String
  description String?
  layoutType  ShelfLayoutType
  width       Int?
  height      Int?
  rows        Int?
  columns     Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  shelves     Shelf[]
}

model Shelf {
  id         String        @id @default(uuid())
  name       String?
  templateId String
  layoutId   String
  posX       Int
  posY       Int
  rotation   Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  layout     StoreLayout   @relation(fields: [layoutId], references: [id])
  template   ShelfTemplate @relation(fields: [templateId], references: [id])
  cells      ShelfCell[]

  @@index([layoutId])
  @@index([templateId])
}

model ShelfItem {
  id        String    @id @default(uuid())
  batchId   String
  cellId    String
  quantity  Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  batch     Batch     @relation(fields: [batchId], references: [id])
  cell      ShelfCell @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([cellId])
}

model ShelfCell {
  id      String      @id @default(uuid())
  shelfId String
  row     Int
  column  Int
  shelf   Shelf       @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  items   ShelfItem[]

  @@unique([shelfId, row, column])
  @@index([shelfId])
}

model Batch {
  id           String         @id @default(uuid())
  variantId    String
  lotNumber    String
  importPrice  Decimal        @db.Decimal(10, 2)
  quantity     Int
  mfgDate      DateTime?
  expDate      DateTime?
  createdAt    DateTime       @default(now())
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  orderItems   OrderItem[]
  shelfItems   ShelfItem[]
  stockInItems StockInItem[]

  @@index([variantId])
  @@index([lotNumber])
}

model StockIn {
  id         String        @id @default(uuid())
  supplierId String
  status     StockInStatus @default(DRAFT)
  notes      String?
  receivedAt DateTime?
  createdAt  DateTime      @default(now())
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  items      StockInItem[]
}

model StockInItem {
  id          String         @id @default(uuid())
  stockInId   String
  variantId   String
  batchId     String?
  quantity    Int
  importPrice Decimal        @db.Decimal(10, 2)
  lotNumber   String?
  mfgDate     DateTime?
  expDate     DateTime?
  createdAt   DateTime       @default(now())
  batch       Batch?         @relation(fields: [batchId], references: [id])
  stockIn     StockIn        @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([stockInId])
  @@index([batchId])
  @@index([variantId])
}

model Order {
  id          String      @id @default(uuid())
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  batchId   String
  variantId String
  quantity  Int
  salePrice Decimal        @db.Decimal(10, 2)
  createdAt DateTime       @default(now())
  batch     Batch          @relation(fields: [batchId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([batchId])
}

model DailyReport {
  id           String   @id @default(uuid())
  date         DateTime @unique @db.Date
  totalRevenue Decimal  @default(0) @db.Decimal(12, 2)
  totalOrders  Int      @default(0)
  totalProfit  Decimal  @default(0) @db.Decimal(12, 2)
  metrics      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

model EmergencyInvoice {
  id                     String                 @id @default(cuid())
  invoiceCode            String                 @unique
  invoiceDate            DateTime               @default(now())
  note                   String?
  totalAmount            Decimal                @db.Decimal(12, 2)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  discountMode           String                 @default("ITEM")
  invoiceDiscountPercent Decimal                @default(0) @db.Decimal(5, 2)
  items                  EmergencyInvoiceItem[]

  @@index([invoiceDate])
  @@index([createdAt])
  @@map("emergency_invoices")
}

model EmergencyInvoiceItem {
  id              String           @id @default(cuid())
  invoiceId       String
  productName     String
  quantity        Int
  unitPrice       Decimal          @db.Decimal(10, 2)
  totalPrice      Decimal          @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  invoice         EmergencyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("emergency_invoice_items")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  isActive      Boolean      @default(true)
  emailVerified Boolean      @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  username      String?      @unique
  profile       UserProfile?

  @@map("Users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String?
  avatarUrl String?
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@map("UserProfiles")
}

enum StockInStatus {
  DRAFT
  CONFIRMED
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

enum ShelfLayoutType {
  DIMENSION
  GRID
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}
